{
  "expo": {
    "name": "AppCarolina",
    "slug": "AppCarolina",
    "version": "2.10",
    "orientation": "portrait",
    "icon": "./assets/IsologoAppLaCarolina.png",
    "splash": {
      "image": "./assets/splashApp.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.agustinbascu.AppCarolina",
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/IsologoAppLaCarolina.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.agustinbascu.AppCarolina"
    },
    "web": {
      "favicon": "./assets/IsologoAppLaCarolina.png"
    }
  }
}
